# Local development overrides. Copy to backend/.env.development and fill in.
#
#   cp backend/.env.development.example backend/.env.development
#
# backend/.env is still loaded first, for API keys and other shared settings. This file is
# layered on top of it and wins. Its job is to keep DATABASE_URL pointed somewhere local.
#
# config.py refuses to start when APP_ENV is development or test and DATABASE_URL names a
# host other than 127.0.0.1, localhost or ::1. So a forgotten or mistyped value fails
# loudly at import instead of quietly reaching production Supabase.
#
# This template is tracked, by an explicit exception in .gitignore. The file you copy it
# to, backend/.env.development, stays ignored by the `.env.*` rule above that exception -
# so your real password never becomes committable. Keep this file free of real values.

APP_ENV=development

# A database on this machine. Nothing else is accepted.
# `raftra_rls_test` is the one the RLS suites already use and it carries the full schema;
# point this at a separate database if you would rather keep that one untouched.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/raftra_rls_test

# Match production so local behaves the same way: requests run as raftra_app and the
# row-level security policies apply.
ENABLE_RLS=true

# Keep a local run quiet and fast. None of these touch the database schema; they stop
# background work that is pointless on a developer machine.
SKIP_EMBEDDING_PRELOAD=1
DISABLE_SCHEDULED_TASKS=true
ENABLE_INTEL_SYNCS=false
ENABLE_MONTHLY_AUDITS=false

# Google sign-in already works locally: the redirect URI resolves to
# http://localhost:8005/api/auth/oauth/google/callback via BACKEND_URL, and that callback
# is registered in the Google Cloud console. GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# come from backend/.env; override them here only if you have separate test credentials.
