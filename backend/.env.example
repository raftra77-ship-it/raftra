# Raftra Backend Environment Variables - PRODUCTION

# 1. Database & Cache
# Supabase PostgreSQL URL (ensure connection pooling port is used for prod, typically 6543)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Upstash Redis URL (use rediss:// for TLS)
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

# 2. Supabase Settings (Storage & Auth)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SUPABASE_BUCKET=raftra-media

# 3. Authentication & Security
# Note: if using Clerk for auth, CLERK_SECRET_KEY is needed
CLERK_ISSUER_URL=https://clerk.yourdomain.com
CLERK_SECRET_KEY=sk_test_...
# Signing key for login tokens. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_generate_a_strong_random_value
FRONTEND_URL=https://app.raftra.com
# Public URL of this backend (used to build OAuth redirect URIs)
BACKEND_URL=http://localhost:8005
# Browser origins allowed to call this API (comma-separated). Use your real frontend domain(s) in production.
CORS_ORIGINS=https://app.raftra.com

# 3a. Social Login (OAuth)
# Google: create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BACKEND_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# 3b. Email (password reset). If SMTP_HOST is unset, reset links are printed to the server console (dev mode).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=no-reply@raftra.com

# 4. Payments (Razorpay)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=secret_...
RAZORPAY_WEBHOOK_SECRET=webhook_secret_here

# 4b. Unattended SEO/GEO audits — OFF unless you set this to true.
#     Audits are user-initiated: they run when someone clicks "Run SEO Pipeline" /
#     "Run GEO Pipeline". Turning this on adds a monthly job (1st of the month, 06:00 UTC)
#     that audits every workspace with a site URL, which costs crawler + LLM quota and
#     produces reports nobody asked for. Leave it off in production unless that's wanted.
ENABLE_MONTHLY_AUDITS=false

# 5. Integrations & Data Sources
COMPOSIO_API_KEY=your_composio_api_key
FIRECRAWL_API_KEY=fc-...
TAVILY_API_KEY=your_tavily_key_here

# 5a. Site Connectors — used by SEO/GEO to publish approved content (PR / draft) and
#     for the "Open to edit" links. Leave blank to keep a connector disabled (its panel
#     will show a "not configured" placeholder).
#
# GitHub — create an OAuth App: https://github.com/settings/developers
#   Authorization callback URL: {BACKEND_URL}/api/connectors/github/callback   (scope: repo)
GITHUB_CLIENT_ID=Iv1_xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Shopify — create an app in the Shopify Partner dashboard: https://partners.shopify.com
#   Redirect URL: {BACKEND_URL}/api/connectors/shopify/callback   (scopes: read_content,write_content)
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# WordPress (self-hosted) — NO server keys required. Each user connects in the UI with
#   their Site URL + WP username + an Application Password
#   (WP Admin -> Users -> Profile -> Application Passwords).
#
# WordPress.com — required ONLY to connect WordPress.com-hosted sites, which have no
#   Application Passwords screen and serve no /wp-json/ of their own. Without these, the
#   panel still works for self-hosted sites and simply hides the WordPress.com button.
#   Create an app: https://developer.wordpress.com/apps/  (type: Web)
#   Redirect URL: {BACKEND_URL}/api/connectors/wordpress/oauth/callback
WPCOM_CLIENT_ID=xxxxx
WPCOM_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Google Search Console & GA4 reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (section 3a above).
#
# Meta Ads (optional) — create an app at https://developers.facebook.com/apps
# META_APP_ID=xxxxxxxxxxxxxxxx
# META_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# PageSpeed (optional) — real Core Web Vitals in the audit's Performance category
# PAGESPEED_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 6. LLM Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-v1-...

# 7. Media Generation APIs
FLUX_API_KEY=your_flux_key_here
IDEOGRAM_API_KEY=your_ideogram_key_here
RECRAFT_API_KEY=your_recraft_key_here
SEEDANCE_API_KEY=your_seedance_key_here
KLING_API_KEY=your_kling_key_here
KOKORO_API_KEY=your_kokoro_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# 4c. Brand-intelligence syncs — OFF unless you set this to true.
#     Adds two background jobs: competitor ads every 2 weeks and market trends every 4.
#     They spend Meta/Apify, SerpApi and YouTube quota for EVERY onboarded workspace, so
#     leave this off unless you want unattended refreshes. Both can always be run on demand
#     from Market Intelligence ("Sync now").
ENABLE_INTEL_SYNCS=false
# Default market for both syncs (ISO country code).
DEFAULT_MARKET_COUNTRY=IN
# Seconds between workspaces in a batch sync, so a burst can't exhaust a free-tier quota.
INTEL_SYNC_SPACING_SEC=20

# 5b. Competitor Ad Library (core/ad_library.py)
#
# IMPORTANT — what the official API can and cannot do. Meta's /ads_archive endpoint returns
# ALL active ads, commercial included, only when ad_reached_countries is an EU/EEA country
# (the DSA requires it there). For every other market — India included — the API is limited
# to ad_type=POLITICAL_AND_ISSUE_ADS. The Ad Library *website* shows commercial ads
# everywhere; the API does not. So:
#   * EU/EEA competitors  -> META_AD_LIBRARY_TOKEN alone is enough.
#   * India and elsewhere -> you also need a third-party collector (APIFY_TOKEN below).
# With neither set, the ad vault stays empty and says why. It never invents ads.
#
# Create an app at https://developers.facebook.com/apps and generate a token with
# ads_read. Ad Library access also requires ID verification on the app.
META_AD_LIBRARY_TOKEN=EAA...
# Apify — non-EU commercial ads. https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...
APIFY_META_ADS_ACTOR=apify~facebook-ads-scraper

# 5c. Market & search trends (core/market_trends.py)
# SerpApi's Google Trends engine — the reliable path for search interest.
SERPAPI_KEY=your_serpapi_key
# YouTube Data API v3 — creator/Shorts references. Free quota 10,000 units/day.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=AIza...
# With neither of the two above set, the radar falls back to pytrends (free, unofficial,
# rate-limited) if it is installed, and reports honestly when nothing answered.
