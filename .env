# Raftra frontend (Vite) environment variables.
# Local only — gitignored. Only VITE_-prefixed vars reach the browser bundle.
#
# NOTE: everything here is PUBLIC by design. Vite inlines these into the JS that
# ships to the browser, so treat them as publishable identifiers, never secrets.
# Secrets belong in backend/.env, which is never bundled.

# Clerk publishable key (safe to expose — it is the public half of the pair).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_dW5pcXVlLWphY2thbC01NS5jbGVyay5hY2NvdW50cy5kZXYk

# Razorpay key id (public). The matching secret lives in backend/.env.
VITE_RAZORPAY_KEY_ID=rzp_test_TM22A5CEVKWhKs8

# Google OAuth client id, used by src/lib/googleDrive.ts for the Drive picker
# (scope: drive.readonly). Public by design.
VITE_GOOGLE_CLIENT_ID=143227504449-cesj2nq3k07po9eoa7l7tfg3v3vf41cq.apps.googleusercontent.com

# WebSocket origin. Left unset so the app uses its default and the Vite dev proxy
# forwards /ws to the backend on :8005 (see vite.config.ts).
# VITE_WS_URL=
